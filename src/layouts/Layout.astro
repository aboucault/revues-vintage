---
import '../styles/global.css'
import { useTranslations, switchLocalePath } from '../i18n'
import type { Locale } from '../i18n'

interface Props {
  title: string
  locale: Locale
  wide?: boolean
}
const { title, locale, wide } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const navLinks = [
  { href: base || '/', label: t.nav.accueil },
  { href: `${base}/revues`, label: t.nav.revues },
  { href: `${base}/dater-un-patron`, label: t.nav.daterUnPatron },
  { href: `${base}/ressources-gratuites`, label: t.nav.ressourcesGratuites },
  { href: `${base}/droits-auteur`, label: t.nav.droitsAuteur },
]

const currentPath = Astro.url.pathname
const homeHref = base || '/'
function isActive(href: string) {
  return href === homeHref ? currentPath === href : currentPath.startsWith(href)
}

const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr'
const otherLocalePath = switchLocalePath(currentPath, otherLocale)
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Revues Vintage</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={homeHref}>Revues Vintage</a>
      <nav class="site-nav">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a class="lang-switch" href={otherLocalePath}>{t.langSwitch.label}</a>
      </nav>
    </header>
    <main class={wide ? 'main--wide' : undefined}>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    padding-bottom: 0.2rem;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
  }

  .lang-switch {
    opacity: 0.75;
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-3);
  }

  main {
    padding: var(--space-4);
    max-width: 1100px;
    margin: 0 auto;
  }

  main.main--wide {
    max-width: 1600px;
  }
</style>
