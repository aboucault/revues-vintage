---
import '../styles/global.css'
import { useTranslations, switchLocalePath } from '../i18n'
import type { Locale } from '../i18n'
import CookieConsent from '../components/CookieConsent.astro'

interface Props {
  title: string
  locale: Locale
  wide?: boolean
  description?: string
  image?: string
  jsonLd?: Record<string, unknown>[]
}
const { title, locale, wide, description, image, jsonLd } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''
const metaDescription = description ?? t.home.heroSubtitle
const metaImage = image ?? new URL('/logo.png', Astro.url).href
const canonicalUrl = Astro.url.href

const navLinks = [
  { href: base || '/', label: t.nav.accueil },
  { href: `${base}/revues`, label: t.nav.revues },
  { href: `${base}/dater-un-patron`, label: t.nav.daterUnPatron },
  { href: `${base}/ressources-gratuites`, label: t.nav.ressourcesGratuites },
  { href: `${base}/soutenir-le-projet`, label: t.nav.soutenirLeProjet },
  { href: `${base}/droits-auteur`, label: t.nav.droitsAuteur },
]

const currentPath = Astro.url.pathname
const homeHref = base || '/'
function isActive(href: string) {
  return href === homeHref ? currentPath === href : currentPath.startsWith(href)
}

const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr'
const otherLocalePath = switchLocalePath(currentPath, otherLocale)

const hreflangFrPath = locale === 'fr' ? currentPath : switchLocalePath(currentPath, 'fr')
const hreflangEnPath = locale === 'en' ? currentPath : switchLocalePath(currentPath, 'en')
const hreflangFrHref = new URL(hreflangFrPath, Astro.url).href
const hreflangEnHref = new URL(hreflangEnPath, Astro.url).href

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Les Revues Vintage',
    url: 'https://revues-vintage.jollyhome.org',
    inLanguage: ['fr', 'en'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Les Revues Vintage',
    url: 'https://revues-vintage.jollyhome.org',
    logo: 'https://revues-vintage.jollyhome.org/logo.png',
  },
]
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Revues Vintage</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={hreflangFrHref} />
    <link rel="alternate" hreflang="en" href={hreflangEnHref} />
    <link rel="alternate" hreflang="x-default" href={hreflangFrHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Les Revues Vintage" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:title" content={`${title} — Revues Vintage`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Revues Vintage`} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={homeHref}>
        <img src="/logo.png" alt="Les Revues Vintage" width="1240" height="217" />
      </a>
      <nav class="site-nav">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a class="lang-switch" href={otherLocalePath}>{t.langSwitch.label}</a>
      </nav>
    </header>
    <main class={wide ? 'main--wide' : undefined}>
      <slot />
    </main>
    <CookieConsent locale={locale} />
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 40px;
    width: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    padding-bottom: 0.2rem;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
  }

  .lang-switch {
    opacity: 0.75;
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-3);
  }

  main {
    padding: var(--space-4);
    max-width: 1100px;
    margin: 0 auto;
  }

  main.main--wide {
    max-width: 1600px;
  }
</style>
