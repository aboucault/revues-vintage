---
import Layout from '../layouts/Layout.astro'
import DetailIcon from './DetailIcon.astro'
import ShareIcon from './ShareIcon.astro'
import FlourishDecoration from './FlourishDecoration.astro'
import { buildShareLinks } from '../lib/shareLinks'
import { useTranslations } from '../i18n'
import type { Locale } from '../i18n'
import type { IconName } from './DetailIcon.astro'

interface MetadataRow {
  icon: IconName
  label: string
  value: string
}

interface Badge {
  label: string
  variant: 'primary' | 'accent' | 'muted'
}

interface Props {
  locale: Locale
  pageTitle: string
  description?: string
  backHref: string
  backLabel: string
  title: string
  subtitle?: string
  badges: Badge[]
  metadata: MetadataRow[]
  infoBox?: { title: string; text: string }
  legalTitle: string
  legalText: string
  shareLabel: string
  shareUrl: string
  shareImageUrl?: string
  copyLabel: string
  copiedLabel: string
  partagerLabel: string
  contentType: 'revue' | 'pochette' | 'patron'
  slug: string
  contentJsonLd?: Record<string, unknown>
}

const {
  locale,
  pageTitle,
  description,
  backHref,
  backLabel,
  title,
  subtitle,
  badges,
  metadata,
  infoBox,
  shareLabel,
  shareUrl,
  shareImageUrl,
  copyLabel,
  copiedLabel,
  partagerLabel,
  contentType,
  slug,
  contentJsonLd,
} = Astro.props

const t = useTranslations(locale)
const shareLinks = buildShareLinks(shareUrl, title, shareImageUrl)

const homeHref = locale === 'en' ? '/en' : '/'
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.accueil, item: new URL(homeHref, Astro.url).href },
    { '@type': 'ListItem', position: 2, name: backLabel, item: new URL(backHref, Astro.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: shareUrl },
  ],
}
const detailJsonLd = contentJsonLd ? [breadcrumbJsonLd, contentJsonLd] : [breadcrumbJsonLd]
---
<Layout title={pageTitle} locale={locale} wide description={description ?? infoBox?.text} image={shareImageUrl} jsonLd={detailJsonLd}>
  <div class="detail-page">
    <aside class="detail-page__sidebar">
      <a class="detail-page__back" href={backHref}>← {backLabel}</a>
      <h1>
        {title}
        {subtitle && <span class="detail-page__subtitle">{subtitle}</span>}
      </h1>
      {badges.length > 0 && (
        <div class="detail-page__badges">
          {badges.map((badge) => (
            <span class={`badge badge--${badge.variant}`}>{badge.label}</span>
          ))}
        </div>
      )}
      {metadata.length > 0 && (
        <ul class="detail-page__metadata">
          {metadata.map((row) => (
            <li>
              <DetailIcon name={row.icon} />
              <span class="detail-page__metadata-label">{row.label}</span>
              <span class="detail-page__metadata-value">{row.value}</span>
            </li>
          ))}
        </ul>
      )}
      {infoBox && (
        <div class="detail-page__info-box">
          <h3><DetailIcon name="info" />{infoBox.title}</h3>
          <p>{infoBox.text}</p>
        </div>
      )}
      <div
        class="detail-page__share"
        id="detail-page-share"
        data-url={shareUrl}
        data-title={title}
        data-content-type={contentType}
        data-slug={slug}
      >
        <span class="detail-page__share-label">{shareLabel}</span>
        <button type="button" id="detail-page-native-share" class="detail-page__share-native" hidden>
          <ShareIcon name="share" />
          <span>{partagerLabel}</span>
        </button>
        <div class="detail-page__share-row" id="detail-page-share-row">
          {shareLinks.pinterest && (
            <a
              href={shareLinks.pinterest}
              target="_blank"
              rel="noopener noreferrer"
              class="detail-page__share-icon"
              data-network="pinterest"
            >
              <ShareIcon name="pinterest" />
            </a>
          )}
          <a
            href={shareLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="detail-page__share-icon"
            data-network="facebook"
          >
            <ShareIcon name="facebook" />
          </a>
          <a href={shareLinks.x} target="_blank" rel="noopener noreferrer" class="detail-page__share-icon" data-network="x">
            <ShareIcon name="x" />
          </a>
          <a
            href={shareLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="detail-page__share-icon"
            data-network="whatsapp"
          >
            <ShareIcon name="whatsapp" />
          </a>
          <a href={shareLinks.email} class="detail-page__share-icon" data-network="email">
            <ShareIcon name="email" />
          </a>
          <button type="button" id="detail-page-copy-link" class="detail-page__copy-button" data-copied-label={copiedLabel}>
            <DetailIcon name="link" />
            <span id="detail-page-copy-label">{copyLabel}</span>
          </button>
        </div>
      </div>
      <FlourishDecoration />
    </aside>
    <div class="detail-page__main">
      <slot />
    </div>
  </div>
</Layout>
<script>
  import { buildShareEvent } from '../lib/analyticsEvents'
  import type { ShareContentType, ShareMethod } from '../lib/analyticsEvents'

  const root = document.getElementById('detail-page-share') as HTMLDivElement | null
  const nativeButton = document.getElementById('detail-page-native-share') as HTMLButtonElement | null
  const shareRow = document.getElementById('detail-page-share-row') as HTMLDivElement | null
  const copyButton = document.getElementById('detail-page-copy-link') as HTMLButtonElement | null
  const copyLabelEl = document.getElementById('detail-page-copy-label') as HTMLSpanElement | null

  if (root) {
    const url = root.dataset.url ?? ''
    const title = root.dataset.title ?? ''
    const contentType = (root.dataset.contentType ?? 'revue') as ShareContentType
    const slug = root.dataset.slug ?? ''

    const trackShare = (method: ShareMethod) => {
      const w = window as typeof window & { dataLayer?: unknown[] }
      w.dataLayer?.push(buildShareEvent(contentType, slug, method))
    }

    const isTouchPrimaryDevice =
      typeof window.matchMedia === 'function' && window.matchMedia('(pointer: coarse)').matches

    if (nativeButton && shareRow && typeof navigator.share === 'function' && isTouchPrimaryDevice) {
      nativeButton.hidden = false
      shareRow.hidden = true
      nativeButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url })
          trackShare('native')
        } catch {
          // Annulation par l'utilisateur (Escape, croix) : pas une erreur à logger.
        }
      })
    }

    shareRow?.querySelectorAll<HTMLAnchorElement>('[data-network]').forEach((link) => {
      const method = link.dataset.network as ShareMethod
      link.addEventListener('click', () => trackShare(method))
    })

    if (copyButton && copyLabelEl) {
      const originalLabel = copyLabelEl.textContent ?? ''
      const copiedLabel = copyButton.dataset.copiedLabel ?? originalLabel

      copyButton.addEventListener('click', async () => {
        trackShare('copy_link')

        try {
          await navigator.clipboard.writeText(url)
          copyLabelEl.textContent = copiedLabel
          setTimeout(() => {
            copyLabelEl.textContent = originalLabel
          }, 2000)
        } catch {
          // Écriture presse-papier refusée par le navigateur (permission, contexte non
          // sécurisé...) : le clic reste un signal d'intention valable pour la mesure,
          // on ne bloque pas dessus, on renonce juste au retour visuel « Lien copié ! ».
        }
      })
    }
  }
</script>
<style>
  .detail-page {
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .detail-page__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .detail-page__back {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.8;
  }

  .detail-page__sidebar h1 {
    font-size: 2.4rem;
    margin: 0;
  }

  .detail-page__subtitle {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-primary);
    margin-left: var(--space-2);
  }

  .detail-page__badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .detail-page__metadata {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.25rem 8.5rem 1fr;
    column-gap: 0.5rem;
    row-gap: var(--space-1);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
    font-size: 0.9rem;
  }

  .detail-page__metadata li {
    display: contents;
  }

  .detail-page__metadata li > * {
    align-self: start;
  }

  .detail-page__metadata-label {
    opacity: 0.7;
    text-align: left;
  }

  .detail-page__metadata-value {
    font-weight: 500;
    text-align: left;
  }

  .detail-page__info-box {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-2);
  }

  .detail-page__info-box h3 {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-page__share {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-1);
  }

  .detail-page__share-label {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .detail-page__share-row {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .detail-page__share-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: none;
    transition: background 0.15s ease;
  }

  .detail-page__share-icon:hover {
    background: var(--color-bg-alt);
  }

  .detail-page__share-native,
  .detail-page__copy-button {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .detail-page__share-native[hidden],
  .detail-page__share-row[hidden] {
    display: none;
  }

  .detail-page__main {
    min-width: 0;
  }

  @media (max-width: 720px) {
    .detail-page {
      grid-template-columns: 1fr;
    }
  }
</style>
