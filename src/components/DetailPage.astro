---
import Layout from '../layouts/Layout.astro'
import DetailIcon from './DetailIcon.astro'
import FlourishDecoration from './FlourishDecoration.astro'
import type { Locale } from '../i18n'
import type { IconName } from './DetailIcon.astro'

interface MetadataRow {
  icon: IconName
  label: string
  value: string
}

interface Badge {
  label: string
  variant: 'primary' | 'accent' | 'muted'
}

interface Props {
  locale: Locale
  pageTitle: string
  backHref: string
  backLabel: string
  title: string
  subtitle?: string
  badges: Badge[]
  metadata: MetadataRow[]
  infoBox?: { title: string; text: string }
  legalTitle: string
  legalText: string
  shareLabel: string
  shareUrl: string
  copyLabel: string
  copiedLabel: string
  contentType: 'revue' | 'pochette' | 'patron'
  slug: string
}

const {
  locale,
  pageTitle,
  backHref,
  backLabel,
  title,
  subtitle,
  badges,
  metadata,
  infoBox,
  shareLabel,
  shareUrl,
  copyLabel,
  copiedLabel,
  contentType,
  slug,
} = Astro.props
---
<Layout title={pageTitle} locale={locale} wide>
  <div class="detail-page">
    <aside class="detail-page__sidebar">
      <a class="detail-page__back" href={backHref}>← {backLabel}</a>
      <h1>
        {title}
        {subtitle && <span class="detail-page__subtitle">{subtitle}</span>}
      </h1>
      {badges.length > 0 && (
        <div class="detail-page__badges">
          {badges.map((badge) => (
            <span class={`badge badge--${badge.variant}`}>{badge.label}</span>
          ))}
        </div>
      )}
      {metadata.length > 0 && (
        <ul class="detail-page__metadata">
          {metadata.map((row) => (
            <li>
              <DetailIcon name={row.icon} />
              <span class="detail-page__metadata-label">{row.label}</span>
              <span class="detail-page__metadata-value">{row.value}</span>
            </li>
          ))}
        </ul>
      )}
      {infoBox && (
        <div class="detail-page__info-box">
          <h3><DetailIcon name="info" />{infoBox.title}</h3>
          <p>{infoBox.text}</p>
        </div>
      )}
      <div class="detail-page__share">
        <span class="detail-page__share-label">{shareLabel}</span>
        <button
          type="button"
          id="detail-page-copy-link"
          class="detail-page__copy-button"
          data-url={shareUrl}
          data-content-type={contentType}
          data-slug={slug}
          data-copied-label={copiedLabel}
        >
          <DetailIcon name="link" />
          <span id="detail-page-copy-label">{copyLabel}</span>
        </button>
      </div>
      <FlourishDecoration />
    </aside>
    <div class="detail-page__main">
      <slot />
    </div>
  </div>
</Layout>
<script>
  import { buildShareEvent } from '../lib/analyticsEvents'
  import type { ShareContentType } from '../lib/analyticsEvents'

  const button = document.getElementById('detail-page-copy-link') as HTMLButtonElement | null
  const labelEl = document.getElementById('detail-page-copy-label') as HTMLSpanElement | null

  if (button && labelEl) {
    const originalLabel = labelEl.textContent ?? ''
    const copiedLabel = button.dataset.copiedLabel ?? originalLabel
    const url = button.dataset.url ?? ''
    const contentType = (button.dataset.contentType ?? 'revue') as ShareContentType
    const slug = button.dataset.slug ?? ''

    button.addEventListener('click', async () => {
      const w = window as typeof window & { dataLayer?: unknown[] }
      w.dataLayer?.push(buildShareEvent(contentType, slug))

      try {
        await navigator.clipboard.writeText(url)
        labelEl.textContent = copiedLabel
        setTimeout(() => {
          labelEl.textContent = originalLabel
        }, 2000)
      } catch {
        // Écriture presse-papier refusée par le navigateur (permission, contexte non
        // sécurisé...) : le clic reste un signal d'intention valable pour la mesure,
        // on ne bloque pas dessus, on renonce juste au retour visuel « Lien copié ! ».
      }
    })
  }
</script>
<style>
  .detail-page {
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .detail-page__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .detail-page__back {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.8;
  }

  .detail-page__sidebar h1 {
    font-size: 2.4rem;
    margin: 0;
  }

  .detail-page__subtitle {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-primary);
    margin-left: var(--space-2);
  }

  .detail-page__badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .detail-page__metadata {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.25rem 8.5rem 1fr;
    column-gap: 0.5rem;
    row-gap: var(--space-1);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
    font-size: 0.9rem;
  }

  .detail-page__metadata li {
    display: contents;
  }

  .detail-page__metadata li > * {
    align-self: start;
  }

  .detail-page__metadata-label {
    opacity: 0.7;
    text-align: left;
  }

  .detail-page__metadata-value {
    font-weight: 500;
    text-align: left;
  }

  .detail-page__info-box {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-2);
  }

  .detail-page__info-box h3 {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-page__share {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-top: var(--space-1);
  }

  .detail-page__share-label {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .detail-page__copy-button {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .detail-page__main {
    min-width: 0;
  }

  @media (max-width: 720px) {
    .detail-page {
      grid-template-columns: 1fr;
    }
  }
</style>
