---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { RevueDoc } from '../../lib/sanity'
import { getRevueDisplayTitre } from '../../lib/revueDetail'

interface Props {
  locale: Locale
  revue: RevueDoc
}

const { locale, revue } = Astro.props
const t = useTranslations(locale)
const downloadHref = revue.statutDroits === 'domaine-public' ? revue.urlScanComplet : undefined
const titreAffiche = getRevueDisplayTitre(revue.titre, revue.dateParution, locale)
---
<Layout title={revue.titre} locale={locale}>
  <div class="revue-detail">
    <div class="revue-detail__main">
      <h1>{titreAffiche}</h1>
      {revue.decennieLabel && <span class="badge badge--primary">{revue.decennieLabel}</span>}
      <p>{revue.editeur} — {revue.numero}</p>
      {revue.couvertureUrl && <img src={revue.couvertureUrl} alt={revue.titre} />}
      {downloadHref && <a href={downloadHref} download>{t.revueDetail.telechargerLaRevueComplete}</a>}
    </div>
    {revue.urlScanComplet && (
      <section class="revue-detail__reader">
        <h2>{t.revueDetail.lireEnLigne}</h2>
        <iframe
          src={revue.urlScanComplet}
          title={revue.titre}
          width="100%"
          height="800"
          style="height: 80vh; border: 1px solid #ccc;"
        >
          <a href={revue.urlScanComplet}>{t.revueDetail.ouvrirLePdf}</a>
        </iframe>
      </section>
    )}
  </div>
</Layout>
