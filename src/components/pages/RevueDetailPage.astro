---
import DetailPage from '../DetailPage.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { RevueDoc } from '../../lib/sanity'
import { formatAnneeOuDate, getPrecisionBadge } from '../../lib/dating'
import { getLegalText } from '../../lib/legal'

interface Props {
  locale: Locale
  revue: RevueDoc
}

const { locale, revue } = Astro.props
const t = useTranslations(locale)
const downloadHref = revue.statutDroits === 'domaine-public' ? revue.urlScanComplet : undefined
const base = locale === 'en' ? '/en' : ''
const dateFormatee = formatAnneeOuDate(revue.annee, revue.dateParution, locale)
const precisionBadge = getPrecisionBadge(Boolean(dateFormatee), revue.precisionDate, {
  certaine: t.detailPage.dateCertaine,
  deduite: t.detailPage.dateDeduite,
})

const badges = [
  { label: t.badges.revue, variant: 'primary' as const },
  ...(revue.decennieLabel ? [{ label: revue.decennieLabel, variant: 'muted' as const }] : []),
  ...(precisionBadge ? [precisionBadge] : []),
]

const metadata = [
  ...(dateFormatee ? [{ icon: 'calendar' as const, label: t.revueDetail.dateParutionLabel, value: dateFormatee }] : []),
  ...(revue.numero ? [{ icon: 'hash' as const, label: t.revueDetail.numeroLabel, value: revue.numero }] : []),
  ...(revue.periodicite ? [{ icon: 'periodicite' as const, label: t.revueDetail.periodiciteLabel, value: revue.periodicite }] : []),
  ...(revue.editeur ? [{ icon: 'building' as const, label: t.revueDetail.editeurLabel, value: revue.editeur }] : []),
  ...(revue.langue ? [{ icon: 'langue' as const, label: t.revueDetail.langueLabel, value: revue.langue }] : []),
  ...(revue.categories.length > 0
    ? [{ icon: 'tags' as const, label: t.revueDetail.categoriesLabel, value: revue.categories.join(' • ') }]
    : []),
]

const infoBox = revue.description ? { title: t.revueDetail.aProposTitre, text: revue.description } : undefined

const shareUrl = Astro.url.href
---
<DetailPage
  locale={locale}
  pageTitle={revue.titre}
  backHref={`${base}/revues`}
  backLabel={t.detailPage.retourAuxRevues}
  title={revue.titre}
  subtitle={dateFormatee}
  badges={badges}
  metadata={metadata}
  infoBox={infoBox}
  legalTitle={t.detailPage.informationsLegales}
  legalText={getLegalText(revue.statutDroits, locale)}
  shareLabel={t.detailPage.partage}
  shareUrl={shareUrl}
  copyLabel={t.detailPage.copierLeLien}
  copiedLabel={t.detailPage.lienCopie}
>
  {downloadHref && (
    <a href={downloadHref} download class="revue-detail__download">
      {t.revueDetail.telechargerLaRevueComplete}
    </a>
  )}
  {revue.urlScanComplet && (
    <section class="revue-detail__reader">
      <iframe
        src={revue.urlScanComplet}
        title={revue.titre}
        width="100%"
        height="800"
        style="height: 80vh; border: 1px solid var(--color-border); border-radius: var(--radius);"
      >
        <a href={revue.urlScanComplet}>{t.revueDetail.ouvrirLePdf}</a>
      </iframe>
    </section>
  )}
</DetailPage>
<style>
  .revue-detail__download {
    display: inline-block;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
