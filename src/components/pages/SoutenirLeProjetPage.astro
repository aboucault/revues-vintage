---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const reseaux = [
  { label: 'YouTube', href: 'https://www.youtube.com/@JeanJones' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@ladymadone' },
]

const tallyFormId = locale === 'en' ? 'Xx7DZd' : 'EkGX9q'
const tallyEmbedSrc = `https://tally.so/embed/${tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`
---
<Layout title={t.pages.soutenirLeProjetTitre} description={t.seo.soutenirLeProjetDescription} locale={locale}>
  <div class="support-grid">
    <div class="kofi-col">
      <section class="kofi-embed">
        <iframe
          id="kofiframe"
          src="https://ko-fi.com/jeanjones/?hidefeed=true&widget=true&embed=true&preview=true"
          style="border:none;width:100%;padding:4px;background:#f9f9f9;"
          height="712"
          title="jeanjones"
        ></iframe>
      </section>
    </div>

    <div class="content-col">
      <h1>{t.pages.soutenirLeProjetTitre}</h1>
      <p>{t.pages.soutenirLeProjetParagraphe1}</p>
      <p>{t.pages.soutenirLeProjetParagraphe2}</p>
      <p>{t.pages.soutenirLeProjetParagraphe3}</p>

      <section class="social-links">
        <h2>{t.pages.soutenirLeProjetReseauxTitre}</h2>
        <div class="social-buttons">
          {reseaux.map((r) => (
            <a class="button" href={r.href} target="_blank" rel="noopener noreferrer">{r.label}</a>
          ))}
        </div>
      </section>

      <section class="contribute">
        <h2>{t.pages.soutenirLeProjetContribuerTitre}</h2>
        <p>{t.pages.soutenirLeProjetContribuerParagraphe}</p>
        <iframe
          data-tally-src={tallyEmbedSrc}
          loading="lazy"
          width="100%"
          height="1425"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title={t.pages.soutenirLeProjetContribuerTitre}
        ></iframe>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  var d = document,
    w = 'https://tally.so/widgets/embed.js',
    v = function () {
      typeof Tally !== 'undefined'
        ? Tally.loadEmbeds()
        : d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (e) {
            e.src = e.dataset.tallySrc
          })
    }
  if (typeof Tally !== 'undefined') v()
  else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement('script')
    s.src = w
    s.onload = v
    s.onerror = v
    d.body.appendChild(s)
  }
</script>

<style>
  .support-grid {
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: var(--space-4);
  }

  .kofi-embed {
    padding: var(--space-2);
    background: var(--color-bg-alt);
    border-radius: var(--radius);
  }

  .social-links {
    margin-top: var(--space-4);
  }

  .contribute {
    margin-top: var(--space-4);
  }

  .contribute iframe {
    border: none;
    display: block;
    margin-top: var(--space-2);
  }

  .social-buttons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
