---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const reseaux = [
  { label: 'YouTube', href: 'https://www.youtube.com/@JeanJones' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@ladymadone' },
]
---
<Layout title={t.pages.soutenirLeProjetTitre} locale={locale}>
  <div class="support-grid">
    <div class="kofi-col">
      <section class="kofi-embed">
        <iframe
          id="kofiframe"
          src="https://ko-fi.com/jeanjones/?hidefeed=true&widget=true&embed=true&preview=true"
          style="border:none;width:100%;padding:4px;background:#f9f9f9;"
          height="712"
          title="jeanjones"
        ></iframe>
      </section>
    </div>

    <div class="content-col">
      <h1>{t.pages.soutenirLeProjetTitre}</h1>
      <p>{t.pages.soutenirLeProjetParagraphe1}</p>
      <p>{t.pages.soutenirLeProjetParagraphe2}</p>
      <p>{t.pages.soutenirLeProjetParagraphe3}</p>

      <section class="social-links">
        <h2>{t.pages.soutenirLeProjetReseauxTitre}</h2>
        <div class="social-buttons">
          {reseaux.map((r) => (
            <a class="button" href={r.href} target="_blank" rel="noopener noreferrer">{r.label}</a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .support-grid {
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: var(--space-4);
  }

  .kofi-embed {
    padding: var(--space-2);
    background: var(--color-bg-alt);
    border-radius: var(--radius);
  }

  .social-links {
    margin-top: var(--space-4);
  }

  .social-buttons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
</content>
