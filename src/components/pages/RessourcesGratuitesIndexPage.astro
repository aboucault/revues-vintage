---
import Layout from '../../layouts/Layout.astro'
import CatalogBrowser from '../CatalogBrowser.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { CatalogEntry } from '../../lib/catalog'

interface Props {
  locale: Locale
  entries: CatalogEntry[]
}

const { locale, entries } = Astro.props
const t = useTranslations(locale)
---
<Layout title={t.seo.ressourcesGratuitesTitle} description={t.seo.ressourcesGratuitesDescription} locale={locale} wide>
  <h1>{t.pages.ressourcesGratuitesTitre}</h1>
  <CatalogBrowser entries={entries} locale={locale} showSearchInput />
</Layout>
