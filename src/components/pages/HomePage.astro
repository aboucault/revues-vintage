---
import Layout from '../../layouts/Layout.astro'
import EntryCard from '../EntryCard.astro'
import FaconIcon from '../FaconIcon.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { CatalogEntry } from '../../lib/catalog'
import type { FaconIconName } from '../FaconIcon.astro'

interface Props {
  locale: Locale
  derniersAjouts: CatalogEntry[]
}

const { locale, derniersAjouts } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const reseaux = [
  { label: t.home.suivreTiktok, href: 'https://www.tiktok.com/@ladymadone' },
  { label: t.home.suivreYoutube, href: 'https://www.youtube.com/@JeanJones' },
]

const facons: Array<{
  titre: string
  description: string
  lien: string
  libelle: string
  icon: FaconIconName
  image: string
  rotate: number
  imageWidthPct: number
  imageRightPct: number
}> = [
  {
    titre: t.home.facon1Titre,
    description: t.home.facon1Description,
    lien: `${base}/revues`,
    libelle: t.home.facon1Libelle,
    icon: 'revue',
    image: '/facon-revue.png',
    rotate: -3,
    imageWidthPct: 50,
    imageRightPct: -18,
  },
  {
    titre: t.home.facon2Titre,
    description: t.home.facon2Description,
    lien: `${base}/dater-un-patron`,
    libelle: t.home.facon2Libelle,
    icon: 'pochette-patron',
    image: '/facon-pochette-patron.png',
    rotate: -2,
    imageWidthPct: 50,
    imageRightPct: -18,
  },
  {
    titre: t.home.facon3Titre,
    description: t.home.facon3Description,
    lien: `${base}/ressources-gratuites`,
    libelle: t.home.facon3Libelle,
    icon: 'patron-gratuit',
    image: '/facon-patron-gratuit.png',
    rotate: 4,
    imageWidthPct: 56,
    imageRightPct: -24,
  },
]
---
<Layout title={t.seo.homeTitle} description={t.seo.homeDescription} locale={locale}>
  <section class="hero">
    <div class="hero-content">
      <h1>{t.home.heroTitle}</h1>
      <div class="hero-divider"></div>
      <p>{t.home.heroSubtitle}</p>
    </div>
    <img class="hero-illustration" src="/hero-illustration.png" alt="" loading="eager" width="900" height="608" />
  </section>

  <section class="facons">
    {facons.map((f) => (
      <div class="facon-card">
        <div class="facon-body">
          <div class="facon-icon-circle">
            <FaconIcon name={f.icon} size={26} />
          </div>
          <h2>{f.titre}</h2>
          <p>{f.description}</p>
          <a href={f.lien}>{f.libelle} →</a>
        </div>
        <img
          class="facon-image"
          src={f.image}
          alt=""
          loading="lazy"
          style={`transform: rotate(${f.rotate}deg); --facon-image-width: ${f.imageWidthPct}%; --facon-image-right: ${f.imageRightPct}%;`}
        />
      </div>
    ))}
  </section>

  <div class="search-section">
    <img class="search-flowers" src="/search-flowers.png" alt="" aria-hidden="true" loading="lazy" width="311" height="400" />
    <form class="search-form" action={`${base}/dater-un-patron`} method="get">
      <label for="q">{t.home.searchLabel}</label>
      <div class="search-row">
        <input id="q" type="search" name="q" placeholder={t.home.searchPlaceholder} />
        <button type="submit">{t.home.searchButton}</button>
      </div>
    </form>
  </div>

  <section class="presentation">
    <div class="presentation-header">
      <img
        class="presentation-photo"
        src="/portrait-auteure.jpg"
        alt=""
        width="56"
        height="56"
        loading="lazy"
      />
      <p>{t.home.presentationTexte}</p>
    </div>
    <div class="presentation-footer">
      <div id="kofi-home-widget" class="kofi-home-widget"></div>
      <script is:inline async src="https://storage.ko-fi.com/cdn/widget/Widget_2.js" id="kofi-widget-loader"></script>
      <script is:inline define:vars={{ kofiLabel: t.home.kofiButtonLabel, kofiColor: '#1f3d2e', kofiId: 'jeanjones' }}>
        document.getElementById('kofi-widget-loader').addEventListener('load', function () {
          kofiwidget2.init(kofiLabel, kofiColor, kofiId)
          document.getElementById('kofi-home-widget').innerHTML = kofiwidget2.getHTML()
        })
      </script>
      <div class="presentation-social">
        {reseaux.map((r) => (
          <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
            {r.label === t.home.suivreTiktok ? (
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2.5v9.3a3.2 3.2 0 1 1-2.2-3.04" />
                <path d="M13 5.3c.4 1.9 1.9 3.3 3.8 3.5" />
              </svg>
            ) : (
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="16" height="10" rx="3" />
                <path d="M8.3 8v4l3.6-2-3.6-2Z" fill="currentColor" stroke="none" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="derniers-ajouts">
    <h2>{t.home.derniersAjouts}</h2>
    <ul class="card-grid">
      {derniersAjouts.map((entry) => <EntryCard entry={entry} locale={locale} />)}
    </ul>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: var(--space-3) 0 var(--space-3);
  }

  .hero-content {
    max-width: calc(100% - min(920px, 66%) - var(--space-4));
  }

  .hero-content h1 {
    font-size: 3rem;
    margin: 0;
  }

  .hero-content p {
    margin: 0;
  }

  .hero-divider {
    width: 60px;
    height: 1px;
    background: var(--color-border);
    margin: var(--space-2) 0;
  }

  .hero-illustration {
    position: absolute;
    top: -73px;
    right: 0;
    width: min(920px, 66%);
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .hero {
      display: flex;
      flex-direction: column;
      text-align: center;
    }

    .hero-content {
      max-width: none;
    }

    .hero-divider {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-illustration {
      position: static;
      transform: none;
      width: min(280px, 70%);
    }
  }

  .search-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: 0 auto var(--space-4);
    max-width: 700px;
  }

  .search-flowers {
    flex-shrink: 0;
    width: 90px;
    height: auto;
  }

  .search-form {
    flex: 1;
    text-align: left;
  }

  .search-form label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  .search-row {
    display: flex;
    gap: var(--space-2);
  }

  .search-row input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .search-row button {
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border: none;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }

  .facons {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4) 0;
    padding-top: var(--space-3);
    background: var(--color-bg);
  }

  .facon-card {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    display: flex;
    align-items: stretch;
    min-height: 220px;
  }

  .facon-body {
    position: relative;
    z-index: 2;
    flex: none;
    width: 66%;
    padding: var(--space-2) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .facon-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-border);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-1);
  }

  .facon-body h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .facon-body p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .facon-body a {
    margin-top: var(--space-1);
  }

  .facon-image {
    position: absolute;
    top: var(--space-3);
    right: var(--facon-image-right, -18%);
    width: var(--facon-image-width, 50%);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.25));
    pointer-events: none;
  }

  .presentation {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin: var(--space-4) 0;
  }

  .presentation-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .presentation-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .presentation-header p {
    margin: 0;
  }

  .presentation-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .presentation-social {
    display: flex;
    gap: var(--space-2);
  }

  .presentation-social a {
    color: var(--color-primary);
    display: flex;
  }

  .kofi-home-widget {
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 720px) {
    .search-row {
      flex-direction: column;
    }

    .search-flowers {
      display: none;
    }

    .presentation-header {
      align-items: flex-start;
    }

    .facon-card {
      flex-direction: column;
      min-height: 0;
    }

    .facon-body {
      flex: none;
      width: 100%;
    }

    .facon-image {
      position: static;
      order: -1;
      width: 100%;
      height: 160px;
      max-height: none;
      object-fit: cover;
      transform: none !important;
      filter: none;
    }
  }
</style>
