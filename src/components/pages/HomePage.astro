---
import Layout from '../../layouts/Layout.astro'
import EntryCard from '../EntryCard.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { CatalogEntry, CatalogEntryType } from '../../lib/catalog'

interface Props {
  locale: Locale
  derniersAjouts: CatalogEntry[]
  faconImages: Partial<Record<CatalogEntryType, string>>
}

const { locale, derniersAjouts, faconImages } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const reseaux = [
  { label: t.home.suivreTiktok, href: 'https://www.tiktok.com/@ladymadone' },
  { label: t.home.suivreYoutube, href: 'https://www.youtube.com/@JeanJones' },
]

const facons = [
  {
    titre: t.home.facon1Titre,
    description: t.home.facon1Description,
    lien: `${base}/revues`,
    libelle: t.home.facon1Libelle,
    image: faconImages.revue,
  },
  {
    titre: t.home.facon2Titre,
    description: t.home.facon2Description,
    lien: `${base}/dater-un-patron`,
    libelle: t.home.facon2Libelle,
    image: faconImages['pochette-patron'],
  },
  {
    titre: t.home.facon3Titre,
    description: t.home.facon3Description,
    lien: `${base}/ressources-gratuites`,
    libelle: t.home.facon3Libelle,
    image: faconImages['patron-gratuit'],
  },
]
---
<Layout title={t.nav.accueil} locale={locale}>
  <section class="hero">
    <div class="hero-content">
      <h1>{t.home.heroTitle}</h1>
      <p>{t.home.heroSubtitle}</p>
    </div>
    <img class="hero-illustration" src="/hero-illustration.png" alt="" loading="eager" width="900" height="608" />
  </section>

  <section class="facons">
    {facons.map((f) => (
      <div class="facon-card">
        {f.image && <img class="facon-image" src={f.image} alt="" loading="lazy" />}
        <div class="facon-body">
          <h2>{f.titre}</h2>
          <p>{f.description}</p>
          <a href={f.lien}>{f.libelle} →</a>
        </div>
      </div>
    ))}
  </section>

  <div class="search-section">
    <img class="search-flowers" src="/search-flowers.png" alt="" aria-hidden="true" loading="lazy" width="311" height="400" />
    <form class="search-form" action={`${base}/revues`} method="get">
      <label for="q">{t.home.searchLabel}</label>
      <div class="search-row">
        <input id="q" type="search" name="q" placeholder={t.home.searchPlaceholder} />
        <button type="submit">{t.home.searchButton}</button>
      </div>
    </form>
  </div>

  <section class="presentation">
    <div class="presentation-header">
      <img
        class="presentation-photo"
        src="/portrait-auteure.jpg"
        alt=""
        width="56"
        height="56"
        loading="lazy"
      />
      <p>{t.home.presentationTexte}</p>
    </div>
    <div class="presentation-footer">
      <a href={`${base}/soutenir-le-projet`}>{t.home.presentationLien} →</a>
      <div class="presentation-social">
        {reseaux.map((r) => (
          <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
            {r.label === t.home.suivreTiktok ? (
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2.5v9.3a3.2 3.2 0 1 1-2.2-3.04" />
                <path d="M13 5.3c.4 1.9 1.9 3.3 3.8 3.5" />
              </svg>
            ) : (
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="16" height="10" rx="3" />
                <path d="M8.3 8v4l3.6-2-3.6-2Z" fill="currentColor" stroke="none" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="derniers-ajouts">
    <h2>{t.home.derniersAjouts}</h2>
    <ul class="card-grid">
      {derniersAjouts.map((entry) => <EntryCard entry={entry} locale={locale} />)}
    </ul>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-illustration {
    flex-shrink: 0;
    width: min(420px, 40%);
    height: auto;
  }

  @media (max-width: 720px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }

    .hero-illustration {
      width: min(280px, 70%);
    }
  }

  .search-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: 0 auto var(--space-4);
    max-width: 700px;
  }

  .search-flowers {
    flex-shrink: 0;
    width: 90px;
    height: auto;
  }

  .search-form {
    flex: 1;
    text-align: left;
  }

  .search-form label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  .search-row {
    display: flex;
    gap: var(--space-2);
  }

  .search-row input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .search-row button {
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border: none;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }

  .facons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .facon-card {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .facon-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  .facon-body {
    padding: var(--space-3);
  }

  .presentation {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin: var(--space-4) 0;
  }

  .presentation-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .presentation-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .presentation-header p {
    margin: 0;
  }

  .presentation-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .presentation-social {
    display: flex;
    gap: var(--space-2);
  }

  .presentation-social a {
    color: var(--color-primary);
    display: flex;
  }

  @media (max-width: 720px) {
    .search-row {
      flex-direction: column;
    }

    .search-flowers {
      display: none;
    }

    .presentation-header {
      align-items: flex-start;
    }
  }
</style>
