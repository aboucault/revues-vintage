---
import Layout from '../../layouts/Layout.astro'
import EntryCard from '../EntryCard.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { CatalogEntry } from '../../lib/catalog'

interface Props {
  locale: Locale
  derniersAjouts: CatalogEntry[]
}

const { locale, derniersAjouts } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const facons = [
  {
    titre: t.home.facon1Titre,
    description: t.home.facon1Description,
    lien: `${base}/revues`,
    libelle: t.home.facon1Libelle,
  },
  {
    titre: t.home.facon2Titre,
    description: t.home.facon2Description,
    lien: `${base}/dater-un-patron`,
    libelle: t.home.facon2Libelle,
  },
  {
    titre: t.home.facon3Titre,
    description: t.home.facon3Description,
    lien: `${base}/ressources-gratuites`,
    libelle: t.home.facon3Libelle,
  },
]
---
<Layout title={t.nav.accueil} locale={locale}>
  <section class="hero">
    <h1>{t.home.heroTitle}</h1>
    <p>{t.home.heroSubtitle}</p>
    <form class="search-form" action={`${base}/revues`} method="get">
      <label for="q">{t.home.searchLabel}</label>
      <div class="search-row">
        <input id="q" type="search" name="q" placeholder={t.home.searchPlaceholder} />
        <button type="submit">{t.home.searchButton}</button>
      </div>
    </form>
  </section>

  <section class="facons">
    {facons.map((f) => (
      <div class="facon-card">
        <h2>{f.titre}</h2>
        <p>{f.description}</p>
        <a href={f.lien}>{f.libelle} →</a>
      </div>
    ))}
  </section>

  <section class="presentation">
    <img
      class="presentation-photo"
      src="/portrait-auteure.jpg"
      alt=""
      width="812"
      height="900"
      loading="lazy"
    />
    <div class="presentation-content">
      <p>{t.home.presentationTexte}</p>
      <a href={`${base}/soutenir-le-projet`}>{t.home.presentationLien} →</a>
    </div>
  </section>

  <section class="derniers-ajouts">
    <h2>{t.home.derniersAjouts}</h2>
    <ul class="card-grid">
      {derniersAjouts.map((entry) => <EntryCard entry={entry} locale={locale} />)}
    </ul>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-4) 0;
  }

  .search-form {
    max-width: 560px;
    margin: var(--space-3) auto 0;
    text-align: left;
  }

  .search-form label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  .search-row {
    display: flex;
    gap: var(--space-2);
  }

  .search-row input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .search-row button {
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border: none;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }

  .facons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .facon-card {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .presentation {
    display: grid;
    grid-template-columns: minmax(160px, 220px) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin: var(--space-4) 0;
  }

  .presentation-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .presentation-content p {
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .presentation {
      grid-template-columns: 1fr;
    }

    .presentation-photo {
      max-width: 220px;
      margin: 0 auto;
    }

    .search-row {
      flex-direction: column;
    }
  }
</style>
