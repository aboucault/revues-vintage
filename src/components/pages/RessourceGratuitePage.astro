---
import DetailPage from '../DetailPage.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { PatronGratuitDoc } from '../../lib/sanity'
import { getLegalText } from '../../lib/legal'
import { canShowGalerie, canShowTranslation } from '../../lib/patronGratuit'
import { getCardSubtitleLines } from '../../lib/card'
import { buildPatronGratuitFallbackDescription } from '../../lib/seo'

interface Props {
  locale: Locale
  patron: PatronGratuitDoc
}

const { locale, patron } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const showGalerie = canShowGalerie(patron)
const showTranslation = canShowTranslation(patron, locale)
const downloadHref = !showGalerie && patron.statutDroits === 'domaine-public' ? patron.fichierUrl : undefined
const revueHref = patron.revueSourceSlug ? `${base}/revues/${patron.revueSourceSlug}` : undefined
const revueSubtitleLines = getCardSubtitleLines(
  {
    numero: patron.revueSourceNumero,
    annee: patron.revueSourceAnnee,
    dateParution: patron.revueSourceDateParution,
    decennieLabel: patron.revueSourceDecennieLabel,
  },
  locale,
)

const badges = [{ label: t.badges.patronGratuit, variant: 'primary' as const }]

const metadata = [
  ...(patron.categories.length > 0
    ? [{ icon: 'tags' as const, label: t.patronGratuitDetail.categoriesLabel, value: patron.categories.join(' • ') }]
    : []),
  ...(patron.typeActivite.length > 0
    ? [{ icon: 'tags' as const, label: t.patronGratuitDetail.typeActiviteLabel, value: patron.typeActivite.join(' • ') }]
    : []),
]

const infoBox = patron.description
  ? { title: t.patronGratuitDetail.aProposTitre, text: patron.description }
  : undefined
const metaDescription = patron.description ?? buildPatronGratuitFallbackDescription(patron.titre, locale)

const patronJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: patron.titre,
  description: metaDescription,
  image: patron.couverturesUrls[0],
  inLanguage: locale,
  isAccessibleForFree: patron.statutDroits === 'domaine-public',
}

const shareUrl = Astro.url.href
---
<DetailPage
  locale={locale}
  pageTitle={patron.titre}
  description={metaDescription}
  backHref={`${base}/ressources-gratuites`}
  backLabel={t.detailPage.retourAuxRessources}
  title={patron.titre}
  badges={badges}
  metadata={metadata}
  infoBox={infoBox}
  legalTitle={t.detailPage.informationsLegales}
  legalText={getLegalText(patron.statutDroits, locale)}
  shareLabel={t.detailPage.partage}
  shareUrl={shareUrl}
  shareImageUrl={patron.couverturesUrls[0]}
  copyLabel={t.detailPage.copierLeLien}
  copiedLabel={t.detailPage.lienCopie}
  partagerLabel={t.detailPage.partagerLabel}
  contentType="patron"
  slug={patron.slug}
  contentJsonLd={patronJsonLd}
>
  {downloadHref && (
    <a href={downloadHref} download class="patron-gratuit__download">
      {t.patronGratuitDetail.telechargerLePatron}
    </a>
  )}
  {showGalerie && revueHref && (
    <section class="patron-gratuit__galerie">
      <a href={revueHref} class="patron-gratuit__source">
        {patron.revueSourceCouvertureUrl && (
          <img
            src={patron.revueSourceCouvertureUrl}
            alt={patron.revueSourceTitre ?? ''}
            class="patron-gratuit__source-image"
            loading="lazy"
          />
        )}
        <span class="patron-gratuit__source-text">
          <span class="patron-gratuit__source-title">
            {t.patronGratuitDetail.voirDansLaRevue(patron.revueSourceTitre ?? '')}
          </span>
          {revueSubtitleLines.length > 0 && (
            <span class="patron-gratuit__source-subtitle">{revueSubtitleLines.join(' · ')}</span>
          )}
        </span>
        <svg
          class="patron-gratuit__source-arrow"
          viewBox="0 0 20 20"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 4l6 6-6 6" />
        </svg>
      </a>
      {showTranslation && (
        <details class="patron-gratuit__translation">
          <summary class="patron-gratuit__translation-summary">
            <span>{t.patronGratuitDetail.lireTraductionInstructions}</span>
            <svg
              class="patron-gratuit__translation-arrow"
              viewBox="0 0 20 20"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 4l6 6-6 6" />
            </svg>
          </summary>
          <p class="patron-gratuit__translation-text">{patron.traductionInstructionsEn}</p>
        </details>
      )}
      {patron.couverturesUrls.map((url, index) => (
        <img
          src={url}
          alt={t.patronGratuitDetail.pageLabel(patron.pages?.[index] ?? index + 1)}
          class="patron-gratuit__page-image"
          loading="lazy"
        />
      ))}
    </section>
  )}
</DetailPage>
<style>
  .patron-gratuit__download {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .patron-gratuit__galerie {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .patron-gratuit__source {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    text-decoration: none;
    color: var(--color-text);
  }
  .patron-gratuit__source-image {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  .patron-gratuit__source-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .patron-gratuit__source-title {
    font-weight: 500;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .patron-gratuit__source-subtitle {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .patron-gratuit__source-arrow {
    flex-shrink: 0;
    color: var(--color-primary);
  }
  .patron-gratuit__translation {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    padding: var(--space-1) var(--space-2);
  }
  .patron-gratuit__translation-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
    list-style: none;
  }
  .patron-gratuit__translation-summary::-webkit-details-marker {
    display: none;
  }
  .patron-gratuit__translation-arrow {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.15s ease;
  }
  .patron-gratuit__translation[open] .patron-gratuit__translation-arrow {
    transform: rotate(90deg);
  }
  .patron-gratuit__translation-text {
    margin-top: var(--space-2);
    white-space: pre-line;
  }
  .patron-gratuit__page-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }
</style>
