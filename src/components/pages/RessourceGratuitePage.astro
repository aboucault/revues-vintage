---
import DetailPage from '../DetailPage.astro'
import { useTranslations } from '../../i18n'
import type { Locale } from '../../i18n'
import type { PatronGratuitDoc } from '../../lib/sanity'
import { getLegalText } from '../../lib/legal'
import { buildRevueReaderUrl, canShowRevueReader } from '../../lib/patronGratuit'

interface Props {
  locale: Locale
  patron: PatronGratuitDoc
}

const { locale, patron } = Astro.props
const t = useTranslations(locale)
const base = locale === 'en' ? '/en' : ''

const showRevueReader = canShowRevueReader(patron)
const pages = patron.pages ?? []
const downloadHref = !showRevueReader && patron.statutDroits === 'domaine-public' ? patron.fichierUrl : undefined
const readerUrl = showRevueReader ? buildRevueReaderUrl(patron.revueScanUrl!, pages[0]) : undefined
const revueHref = patron.revueSourceSlug ? `${base}/revues/${patron.revueSourceSlug}` : undefined

const badges = [{ label: t.badges.patronGratuit, variant: 'primary' as const }]

const metadata = [
  ...(patron.categories.length > 0
    ? [{ icon: 'tags' as const, label: t.patronGratuitDetail.categoriesLabel, value: patron.categories.join(' • ') }]
    : []),
  ...(patron.typeActivite.length > 0
    ? [{ icon: 'tags' as const, label: t.patronGratuitDetail.typeActiviteLabel, value: patron.typeActivite.join(' • ') }]
    : []),
]

const infoBox = patron.description
  ? { title: t.patronGratuitDetail.aProposTitre, text: patron.description }
  : undefined

const shareUrl = Astro.url.href
---
<DetailPage
  locale={locale}
  pageTitle={patron.titre}
  backHref={`${base}/ressources-gratuites`}
  backLabel={t.detailPage.retourAuxRessources}
  title={patron.titre}
  badges={badges}
  metadata={metadata}
  infoBox={infoBox}
  legalTitle={t.detailPage.informationsLegales}
  legalText={getLegalText(patron.statutDroits, locale)}
  shareLabel={t.detailPage.partage}
  shareUrl={shareUrl}
  copyLabel={t.detailPage.copierLeLien}
  copiedLabel={t.detailPage.lienCopie}
>
  {downloadHref && (
    <a href={downloadHref} download class="patron-gratuit__download">
      {t.patronGratuitDetail.telechargerLePatron}
    </a>
  )}
  {showRevueReader && (
    <section class="patron-gratuit__reader">
      {pages.length > 1 && (
        <div class="patron-gratuit__pages" data-scan-url={patron.revueScanUrl}>
          {pages.map((page, index) => (
            <button
              type="button"
              class="patron-gratuit__page-button"
              data-page={page}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {t.patronGratuitDetail.pageLabel(page)}
            </button>
          ))}
        </div>
      )}
      <iframe
        id="patron-gratuit-reader"
        src={readerUrl}
        title={patron.titre}
        width="100%"
        height="800"
        style="height: 80vh; border: 1px solid var(--color-border); border-radius: var(--radius);"
      >
        <a href={readerUrl}>{t.revueDetail.ouvrirLePdf}</a>
      </iframe>
      {revueHref && (
        <a href={revueHref} class="patron-gratuit__revue-link">
          {t.patronGratuitDetail.voirDansLaRevue(patron.revueSourceTitre ?? '')}
        </a>
      )}
    </section>
  )}
</DetailPage>
<style>
  .patron-gratuit__download {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .patron-gratuit__pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .patron-gratuit__page-button {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-text);
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    font: inherit;
  }
  .patron-gratuit__page-button[aria-pressed='true'] {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-color: var(--color-primary);
  }
  .patron-gratuit__revue-link {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-primary);
    font-size: 0.9rem;
  }
</style>
<script>
  const pagesContainer = document.querySelector('.patron-gratuit__pages') as HTMLDivElement | null
  const reader = document.getElementById('patron-gratuit-reader') as HTMLIFrameElement | null

  if (pagesContainer && reader) {
    const scanUrl = pagesContainer.dataset.scanUrl
    const buttons = pagesContainer.querySelectorAll<HTMLButtonElement>('.patron-gratuit__page-button')
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const page = button.dataset.page
        if (!scanUrl || !page) return
        reader.src = `${scanUrl}#page=${page}`
        buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn === button)))
      })
    })
  }
</script>
