---
export type FaconIconName = 'revue' | 'pochette-patron' | 'patron-gratuit'

interface Props {
  name: FaconIconName
  size?: number
}

const { name, size = 20 } = Astro.props

const paths: Record<FaconIconName, string> = {
  revue:
    '<path d="M10 5.5c-1.8-1.3-4.4-1.3-6.5-0.5v11c2.1-.8 4.7-.8 6.5.5"/><path d="M10 5.5c1.8-1.3 4.4-1.3 6.5-.5v11c-2.1-.8-4.7-.8-6.5.5V5.5Z"/>',
  'pochette-patron': '<circle cx="8.5" cy="8.5" r="5"/><path d="M12.5 12.5 17 17"/>',
  'patron-gratuit': '<path d="M10 3v10"/><path d="M6 9.5 10 13.5 14 9.5"/><path d="M4 16.5h12"/>',
}
---
<svg
  class="facon-icon"
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name]}
/>
<style>
  .facon-icon {
    flex-shrink: 0;
  }
</style>
