---
import type { CatalogEntry } from '../lib/catalog'
import { buildFacetOptions } from '../lib/facets'

interface Props {
  entries: CatalogEntry[]
  showMarqueFilter?: boolean
  showCaracteristiquesFilter?: boolean
  showTitreFilter?: boolean
  showSearchInput?: boolean
  initialQuery?: string
}

const {
  entries,
  showMarqueFilter = false,
  showCaracteristiquesFilter = false,
  showTitreFilter = false,
  showSearchInput = false,
  initialQuery = '',
} = Astro.props

const categorieOptions = buildFacetOptions(entries.flatMap((e) => e.categories))
const decennieOptions = buildFacetOptions(
  entries.map((e) => e.decennieLabel).filter((v): v is string => Boolean(v))
)
const titreOptions = showTitreFilter ? buildFacetOptions(entries.map((e) => e.titre)) : []
const marqueOptions = showMarqueFilter
  ? buildFacetOptions(entries.map((e) => e.marqueNom).filter((v): v is string => Boolean(v)))
  : []
const caracteristiqueOptions = showCaracteristiquesFilter
  ? buildFacetOptions(entries.flatMap((e) => e.caracteristiquesStyle))
  : []
---
<div class="catalog-browser">
  <form id="filter-form" class="catalog-filters">
    {showSearchInput && (
      <label class="filter-group">
        Rechercher
        <input type="search" name="q" value={initialQuery} placeholder="Ex : robe portefeuille 1948" />
      </label>
    )}

    {decennieOptions.length > 0 && (
      <fieldset class="filter-group">
        <legend>Décennie</legend>
        {decennieOptions.map((option) => (
          <label class="filter-option">
            <input type="checkbox" name="decennies" value={option.value} />
            {option.value} ({option.count})
          </label>
        ))}
      </fieldset>
    )}

    {showTitreFilter && titreOptions.length > 0 && (
      <fieldset class="filter-group">
        <legend>Titre de revue</legend>
        {titreOptions.map((option) => (
          <label class="filter-option">
            <input type="checkbox" name="titres" value={option.value} />
            {option.value} ({option.count})
          </label>
        ))}
      </fieldset>
    )}

    {categorieOptions.length > 0 && (
      <fieldset class="filter-group">
        <legend>Catégorie</legend>
        {categorieOptions.map((option) => (
          <label class="filter-option">
            <input type="checkbox" name="categories" value={option.value} />
            {option.value} ({option.count})
          </label>
        ))}
      </fieldset>
    )}

    {showMarqueFilter && marqueOptions.length > 0 && (
      <fieldset class="filter-group">
        <legend>Marque</legend>
        {marqueOptions.map((option) => (
          <label class="filter-option">
            <input type="checkbox" name="marques" value={option.value} />
            {option.value} ({option.count})
          </label>
        ))}
      </fieldset>
    )}

    {showCaracteristiquesFilter && caracteristiqueOptions.length > 0 && (
      <fieldset class="filter-group">
        <legend>Caractéristique de style</legend>
        {caracteristiqueOptions.map((option) => (
          <label class="filter-option">
            <input type="checkbox" name="caracteristiques" value={option.value} />
            {option.value} ({option.count})
          </label>
        ))}
      </fieldset>
    )}

    <label class="filter-group">
      Trier par
      <select name="sort">
        <option value="recent">Plus récents</option>
        <option value="titre-asc">Titre (A→Z)</option>
      </select>
    </label>
  </form>

  <div class="catalog-results">
    <p id="result-count" class="result-count"></p>
    <ul id="results-list" class="card-grid"></ul>
    <p id="empty-state" class="empty-state" hidden>
      Aucun résultat. Essayez de modifier vos filtres ou votre recherche.
    </p>
  </div>
</div>

<script type="application/json" id="catalog-data" set:html={JSON.stringify(entries)} />

<script>
  import { filterCatalog } from '../lib/filter'
  import { sortEntries } from '../lib/sort'
  import { renderEntryCardHtml } from '../lib/card'
  import type { CatalogEntry } from '../lib/catalog'
  import type { SortOption } from '../lib/sort'

  const dataEl = document.getElementById('catalog-data') as HTMLScriptElement
  const entries: CatalogEntry[] = JSON.parse(dataEl.textContent ?? '[]')
  const form = document.getElementById('filter-form') as HTMLFormElement
  const resultsList = document.getElementById('results-list') as HTMLUListElement
  const resultCount = document.getElementById('result-count') as HTMLParagraphElement
  const emptyState = document.getElementById('empty-state') as HTMLParagraphElement

  function getCheckedValues(name: string): string[] {
    return new FormData(form).getAll(name).map(String)
  }

  function render(list: CatalogEntry[]) {
    resultsList.innerHTML = list.map(renderEntryCardHtml).join('')
    resultCount.textContent = `${list.length} résultat${list.length > 1 ? 's' : ''}`
    emptyState.hidden = list.length > 0
  }

  function applyFilters() {
    const formData = new FormData(form)
    const filtered = filterCatalog(entries, {
      q: (formData.get('q') as string) || undefined,
      categories: getCheckedValues('categories'),
      marques: getCheckedValues('marques'),
      decennies: getCheckedValues('decennies'),
      caracteristiques: getCheckedValues('caracteristiques'),
      titres: getCheckedValues('titres'),
    })
    const sort = (formData.get('sort') as SortOption) || 'recent'
    render(sortEntries(filtered, sort))
  }

  form.addEventListener('input', applyFilters)
  applyFilters()
</script>

<style>
  .catalog-browser {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .catalog-filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg-alt);
    border-radius: var(--radius);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border: none;
    padding: 0;
    margin: 0;
    font-weight: 600;
  }

  .filter-option {
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .result-count {
    color: var(--color-text);
    opacity: 0.75;
  }

  .empty-state {
    opacity: 0.75;
  }
</style>
