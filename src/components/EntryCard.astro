---
import { getEntryPath } from '../lib/catalog'
import type { CatalogEntry } from '../lib/catalog'
import { getBadgeLabel, getBadgeVariant } from '../lib/badge'

interface Props {
  entry: CatalogEntry
}

const { entry } = Astro.props
const href = getEntryPath(entry)
const badgeClass = `badge badge--${getBadgeVariant(entry.type)}`
---
{href ? (
  <a class="card" href={href}>
    <span class={badgeClass}>{getBadgeLabel(entry.type)}</span>
    {entry.imageUrl && <img src={entry.imageUrl} alt={entry.titre} loading="lazy" />}
    <span class="card-title">{entry.titre}</span>
  </a>
) : (
  <div class="card">
    <span class={badgeClass}>{getBadgeLabel(entry.type)}</span>
    {entry.imageUrl && <img src={entry.imageUrl} alt={entry.titre} loading="lazy" />}
    <span class="card-title">{entry.titre}</span>
  </div>
)}
