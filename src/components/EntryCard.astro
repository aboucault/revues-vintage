---
import { getEntryPath } from '../lib/catalog'
import type { CatalogEntry } from '../lib/catalog'
import { getBadgeLabel, getBadgeVariant } from '../lib/badge'
import { getCardSubtitleLines } from '../lib/card'
import type { Locale } from '../i18n'

interface Props {
  entry: CatalogEntry
  locale: Locale
}

const { entry, locale } = Astro.props
const basePath = getEntryPath(entry)
const href = basePath && locale === 'en' ? `/en${basePath}` : basePath
const badgeClass = `card-badge badge--${getBadgeVariant(entry.type)}`
const subtitleLines = getCardSubtitleLines(entry, locale)
---
{href ? (
  <a class="card" href={href}>
    <div class="card-media">
      {entry.imageUrl && <img src={entry.imageUrl} alt={entry.titre} loading="lazy" />}
      <span class={badgeClass}>{getBadgeLabel(entry.type, locale)}</span>
    </div>
    <span class="card-title">{entry.titre}</span>
    {subtitleLines.map((line) => <span class="card-subtitle">{line}</span>)}
  </a>
) : (
  <div class="card">
    <div class="card-media">
      {entry.imageUrl && <img src={entry.imageUrl} alt={entry.titre} loading="lazy" />}
      <span class={badgeClass}>{getBadgeLabel(entry.type, locale)}</span>
    </div>
    <span class="card-title">{entry.titre}</span>
    {subtitleLines.map((line) => <span class="card-subtitle">{line}</span>)}
  </div>
)}
