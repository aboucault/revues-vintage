---
import HomePage from '../../components/pages/HomePage.astro'
import { fetchRevues, fetchPochettesPatron, fetchPatronsGratuits } from '../../lib/sanity'
import { buildCatalog, pickRepresentativeImage } from '../../lib/catalog'
import { sortEntries } from '../../lib/sort'

const [revues, pochettes, patronsGratuits] = await Promise.all([
  fetchRevues('en'),
  fetchPochettesPatron('en'),
  fetchPatronsGratuits('en'),
])
const entries = buildCatalog(revues, pochettes, patronsGratuits)
const sorted = sortEntries(entries, 'recent')
const derniersAjouts = sorted.slice(0, 6)
const faconImages = {
  revue: pickRepresentativeImage(sorted, 'revue'),
  'pochette-patron': pickRepresentativeImage(sorted, 'pochette-patron'),
  'patron-gratuit': pickRepresentativeImage(sorted, 'patron-gratuit'),
}
---
<HomePage locale="en" derniersAjouts={derniersAjouts} faconImages={faconImages} />
